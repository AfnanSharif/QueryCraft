DATABASE_PATH=.local/food_delivery.db
DATABASE_BACKEND=sqlite
MAX_RESULT_ROWS=200
QUERY_TIMEOUT_MS=1500

# Optional UI gate; leave blank for a local demo.
# APP_PASSWORD=use-a-secret-manager-in-production

# Optional OpenAI generator
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPTIMIZE_QUERIES=0

# Databricks SQL warehouse (use a least-privilege token and read-only grants)
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=

# Snowflake (SNOWFLAKE_ROLE should have SELECT on approved views only)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=
